@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebDoctor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebDoctor.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <!-- Сменето од navbar-light bg-white во navbar-dark bg-dark за модерен темен изглед -->
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark shadow-sm mb-4 py-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold fs-4 text-info" asp-area="" asp-controller="Home" asp-action="Index">
                    🩺 WebDoctor
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item">
                            <a class="nav-link text-light px-2" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var userType = User.FindFirst("UserType")?.Value;

                            @if (userType == "0")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-light px-2" asp-controller="Home" asp-action="Privacy">Privacy</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-light px-2" asp-controller="Doctors" asp-action="Index">Doctors</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-light px-2" asp-controller="Appointments" asp-action="Index">Appointments</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-light px-2" asp-controller="Patients" asp-action="Index">Patients</a>
                                </li>
                            }
                            else if (userType == "1")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-light px-2" asp-controller="Patients" asp-action="Index">Patients</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-light px-2" asp-controller="Appointments" asp-action="Index">Appointments</a>
                                </li>
                            }
                            else if (userType == "2")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-light px-2" asp-controller="Appointments" asp-action="Index">Appointments</a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item me-3">
                                <span class="text-warning fw-semibold">Hello, @User.Identity.Name!</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-light btn-sm px-3">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-info btn-sm px-4 fw-bold text-dark" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container text-center">
            &copy; 2026 - WebDoctor - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>