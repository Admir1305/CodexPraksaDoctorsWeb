@model IEnumerable<WebDoctor.Models.Appointments>
@{
    ViewData["Title"] = "Appointments";
}
<div class="container mt-4" id="appointment-page" data-data-url="@Url.Action("Data", "Appointments")">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Appointments</h2>
        <a asp-action="Create" class="btn btn-primary">Schedule New Appointment</a>
    </div>
    <div class="row g-3 mb-3" aria-live="polite">
        <div class="col"><div class="card p-3"><strong>Total</strong><span id="stat-total">0</span></div></div>
        <div class="col"><div class="card p-3"><strong>Scheduled</strong><span id="stat-scheduled">0</span></div></div>
        <div class="col"><div class="card p-3"><strong>In progress</strong><span id="stat-in-progress">0</span></div></div>
        <div class="col"><div class="card p-3"><strong>Completed</strong><span id="stat-completed">0</span></div></div>
    </div>
    <form id="appointment-filters" class="card card-body mb-3">
        <div class="row g-2">
            <div class="col-md-2"><label class="form-label" for="dateFrom">Date from</label><input id="dateFrom" name="dateFrom" type="date" value="@ViewBag.DateFrom" class="form-control" /></div>
            <div class="col-md-2"><label class="form-label" for="dateTo">Date to</label><input id="dateTo" name="dateTo" type="date" value="@ViewBag.DateTo" class="form-control" /></div>
            <div class="col-md-2"><label class="form-label" for="statusId">Status</label><select id="statusId" name="statusId" asp-items="ViewBag.Statuses" class="form-select"><option value="" selected="@(ViewBag.StatusId == null ? "selected" : null)">All statuses</option></select></div>
            <div class="col-md-2"><label class="form-label" for="doctorId">Doctor</label><select id="doctorId" name="doctorId" asp-items="ViewBag.Doctors" class="form-select"><option value="" selected="@(ViewBag.DoctorId == null ? "selected" : null)">All doctors</option></select></div>
            <div class="col-md-2"><label class="form-label" for="patientId">Patient</label><select id="patientId" name="patientId" asp-items="ViewBag.Patients" class="form-select"><option value="" selected="@(ViewBag.PatientId == null ? "selected" : null)">All patients</option></select></div>
            <div class="col-md-2 d-flex align-items-end gap-2"><button class="btn btn-primary" type="submit">Filter</button><button class="btn btn-secondary" type="reset">Clear</button></div>
        </div>
        <div class="mt-3"><label class="form-label" for="appointment-search">Search patient, EMBG, doctor, or specialty</label><input id="appointment-search" type="search" class="form-control" placeholder="Type to search…" /></div>
    </form>

    <div id="appointment-error" class="alert alert-danger d-none" role="alert"></div>
    <div class="table-responsive">
        <table class="table table-striped table-bordered" id="appointments-table">
            <thead class="table-dark"><tr>
                <th><button type="button" class="btn btn-link link-light p-0 sort-button" data-sort="date">Date</button></th>
                <th><button type="button" class="btn btn-link link-light p-0 sort-button" data-sort="time">Time</button></th>
                <th><button type="button" class="btn btn-link link-light p-0 sort-button" data-sort="patient">Patient</button></th>
                <th>EMBG</th>
                <th><button type="button" class="btn btn-link link-light p-0 sort-button" data-sort="doctor">Doctor</button></th>
                <th>Specialty</th>
                <th><button type="button" class="btn btn-link link-light p-0 sort-button" data-sort="status">Status</button></th>
                <th>Notes</th>
            </tr></thead>
            <tbody id="appointments-body"><tr><td colspan="8" class="text-center">Loading…</td></tr></tbody>
        </table>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-4"><button id="page-previous" type="button" class="btn btn-outline-primary">Previous</button><span id="page-label" aria-live="polite">Page 1 of 1</span><button id="page-next" type="button" class="btn btn-outline-primary">Next</button></div>
</div>
