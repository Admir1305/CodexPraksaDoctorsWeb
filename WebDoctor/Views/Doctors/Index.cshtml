@model IEnumerable<WebDoctor.Models.Doctors>
@{
    ViewData["Title"] = "All doctors";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Doctors List</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-person-plus-fill me-1"></i> Add New Doctor
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Phone</th>
                        <th>Active</th>
                        <th>Specialty</th>
                        <th class="text-center" style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doctor in Model)
                    {
                        <tr>
                            <td>@doctor.Id</td>
                            <td>@doctor.FirstName</td>
                            <td>@doctor.LastName</td>
                            <td>@doctor.Phone</td>
                            <td>@doctor.IsActiveTemp</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(doctor.SpecialtyName))
                                {
                                    <span class="badge bg-info text-dark">@doctor.SpecialtyName</span>
                                }
                                else
                                {
                                    <span class="text-muted">No specialty assigned</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@doctor.Id" class="btn btn-outline-warning btn-sm me-1" title="Edit">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>

                                <a onclick="DeleteDoctor(@doctor.Id)" asp-route-id="@doctor.Id" class="btn btn-outline-danger btn-sm" title="Delete">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-3" role="alert">
            <i class="bi bi-info-circle me-2"></i> No doctors currently found in the database.
        </div>
    }
</div>
<script>

    function DeleteDoctor(Id){
        console.log(Id);
        if(confirm("Are you sure you want to delete this doctor?")){
            fetch('/Doctors/Delete/' + Id, {
                method: 'DELETE'
            })
            .then(response => { // Changed parameter to lowercase 'response' for consistency
                if (response.ok){
                    
                    console.log('response.ok');
                    location.reload();
                }
                else {
                    alert("Error deleting doctor! Server returned status: " + response.status);
                }
            })
            .catch(error => {
                console.error('Error', error);
            });
        }
    }
</script>
