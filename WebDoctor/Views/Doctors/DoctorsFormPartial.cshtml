@model WebDoctor.Models.Doctors

@{
    
    bool isEdit = Model.Id > 0;
    
   
    ViewData["Title"] = isEdit ? "Edit Doctor" : "Add New Doctor";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header @(isEdit ? "bg-warning text-dark" : "bg-primary text-white")">
                    <h4 class="mb-0">@(isEdit ? "Edit Doctor" : "Add New Doctor")</h4>
                </div>
                <div class="card-body">
                  
                    <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
                        
                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="Id" />
                        }

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FirstName" class="form-label">First Name</label>
                            <input asp-for="FirstName" class="form-control" placeholder="Enter doctor's first name" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastName" class="form-label">Last Name</label>
                            <input asp-for="LastName" class="form-control" placeholder="Enter doctor's last name" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                       
                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">Phone</label>
                            <input asp-for="Phone" class="form-control" placeholder="+389 00 000 000" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SpecialtyId" class="form-label">Specialty</label>
                            <select asp-for="SpecialtyId" class="form-select">
                                <option value="">-- Select Specialty --</option>
                                @if (Model.Specialties != null)
                                {
                                    @foreach (var item in Model.Specialties)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="SpecialtyId" class="text-danger"></span>
                        </div>
                                     
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                            
                            <button type="submit" class="btn @(isEdit ? "btn-primary" : "btn-success")">
                                <i class="bi bi-check-circle"></i> @(isEdit ? "Update" : "Save")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
